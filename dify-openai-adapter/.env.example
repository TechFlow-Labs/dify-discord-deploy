# Copy: cp .env.example .env
# Also: cp agents.json.example agents.json  (put real app-… keys there)
# Never commit .env or agents.json

# Dify Service API (include /v1)
DIFY_BASE_URL=https://YOUR_DIFY_HOST/v1

# Optional inline map (JSON). Prefer agents.json instead.
# DIFY_AGENTS={"marketing-agent":"app-xxx"}

AGENTS_FILE=agents.json

# Bind for OpenWebUI / reverse proxy
ADAPTER_HOST=0.0.0.0
ADAPTER_PORT=8085
