# Top-level checklist — copy values into each service .env (do not use this file as-is).
# Per service:
#   cp discord-dify-poc/.env.example discord-dify-poc/.env
#   cp dify-openai-adapter/.env.example dify-openai-adapter/.env
#   cp dify-openai-adapter/agents.json.example dify-openai-adapter/agents.json

# --- After Dify is up (fill into discord-dify-poc/.env) ---
# DIFY_BASE_URL=https://YOUR_DIFY_HOST/v1
# DIFY_API_KEY=app-...   # from published agent in live Dify

# --- Discord (one path is enough) ---
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_TOKEN=
# POC_CHANNEL_ID=

# --- Optional: OpenWebUI adapter (dify-openai-adapter/.env + agents.json) ---
# DIFY_BASE_URL=https://YOUR_DIFY_HOST/v1
# ADAPTER_HOST=0.0.0.0
# ADAPTER_PORT=8085

# --- Optional: SCS on same host (set in SCS repo .env, not here) ---
# DIFY_EXTERNAL_API_KEY=   # openssl rand -hex 24
# RULES_REFRESH_SECRET=    # openssl rand -hex 24
# RULES_SOURCE_DIR=/path/to/EmblemTameiaki/docs/rules
