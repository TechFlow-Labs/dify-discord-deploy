# Copy: cp .env.example .env
# Never commit .env

# --- Path A: outbound posts only (webhook, no bot token) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE/REPLACE

# --- Path B: interactive bot (Discord Developer Portal → Bot → Token) ---
DISCORD_TOKEN=
POC_CHANNEL_ID=

# Live Dify Service API (include /v1)
DIFY_BASE_URL=https://YOUR_DIFY_HOST/v1
# From Dify → app → API Access after publish
DIFY_API_KEY=app-xxxxxxxx
